# Database
DATABASE_URL="postgresql://user:password@localhost:5432/ai_agency?schema=public"

# Auth
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"
SUPER_ADMIN_EMAILS=""

# Server
NODE_ENV="development"
PORT=4000
CORS_ORIGIN="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"
# Number of trusted reverse-proxy hops. Usually 1 behind Render directly, or 2
# when requests go through a Vercel rewrite before reaching Render.
TRUST_PROXY_HOPS=0
# Set to true temporarily to log the client IP on each API request.
DEBUG_IP=false

# AI
OPENAI_API_KEY="sk-..."
OLLAMA_URL="http://localhost:11434/api/generate"
OLLAMA_MODEL="llama3.2"

# SMS + voice (Twilio)
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="..."
TWILIO_PHONE_NUMBER="+15551234567"
PUBLIC_API_URL="https://your-public-api.example.com"

# Outbound email (Resend)
RESEND_API_KEY="re_..."
# Must use a sender address on a domain verified in Resend. Gmail cannot be
# used as the sender; the notification recipient can still be a Gmail inbox.
RESEND_FROM_EMAIL="Business <messages@your-verified-domain.com>"
SALES_NOTIFICATION_EMAIL="you@your-business.com"

# WhatsApp Business API (only needed once you have real Meta access -
# see WHATSAPP_SETUP.md at the project root for the full walkthrough)
# WHATSAPP_ACCESS_TOKEN=d
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=your-own-random-string
# Required to validate inbound Meta webhook signatures.
META_APP_SECRET=
